# Public site URL used for canonical / hreflang / sitemap
VITE_SITE_URL=https://www.hlcenergies.com

# Set to "true" on staging/preview to emit <meta name="robots" content="noindex,nofollow">.
# Leave blank in production so pages stay indexable.
VITE_NOINDEX=

# Contact form delivery (server-only — never exposed to the client)
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Analytics id — only after analytics approval
ANALYTICS_ID=
