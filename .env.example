# Public site URL used for canonical / hreflang / sitemap
VITE_SITE_URL=https://www.hlcenergies.com

# Set to "true" on staging/preview to emit <meta name="robots" content="noindex,nofollow">.
# Leave blank in production so pages stay indexable.
VITE_NOINDEX=

# Contact form delivery via Resend (server-only — never exposed to the client)
# RESEND_API_KEY: from resend.com. CONTACT_FROM_EMAIL must be an address on a
# domain verified in Resend (e.g. "HLC Energies <contacto@hlcenergies.com>").
# CONTACT_TO_EMAIL is where submissions are received.
RESEND_API_KEY=
CONTACT_TO_EMAIL=info.moz@hlmic.com
CONTACT_FROM_EMAIL=

# Analytics id — only after analytics approval
ANALYTICS_ID=
